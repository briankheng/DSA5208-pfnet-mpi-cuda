#!/bin/bash
#PBS -N pfnet_serial
#PBS -q auto_free
#PBS -l select=1:ncpus=1:ngpus=1:mem=16gb
#PBS -l walltime=01:30:00
#PBS -j oe
cd "$PBS_O_WORKDIR"
source scripts/cluster_env.sh
mkdir -p out results

for n in 2048 4096 8192; do
    for rep in 1 2 3; do
        bin/serial -n $n --csv results/serial.csv --out out/edges_serial_$n.txt
    done
done
